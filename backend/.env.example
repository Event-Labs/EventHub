# App & Server Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database & Cache
DATABASE_URL=postgresql://user:password@localhost:5432/eventhub
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security & JWT
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=app_password
EMAIL_FROM=no-reply@eventhub.vn
EMAIL_VERIFY_EXPIRES_IN=86400
PASSWORD_RESET_EXPIRES_IN=3600

# Payment (PayOS)
PLATFORM_PAYOS_CLIENT_ID=
PLATFORM_PAYOS_API_KEY=
PLATFORM_PAYOS_CHECKSUM_KEY=

# Feature Flags (Defaults to false / OFF)
ZERO_AMOUNT_CHECKOUT_ENABLED=false
STAFF_COMPLIMENTARY_BOOKING_ENABLED=false
