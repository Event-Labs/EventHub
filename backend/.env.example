# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/eventhub

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
EMAIL_FROM="EventHub <noreply@eventhub.vn>"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Security
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_IN=15m
EMAIL_VERIFY_EXPIRES_IN=24h

# Frontend
CLIENT_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Platform PayOS
PLATFORM_PAYOS_CLIENT_ID=your_payos_client_id
PLATFORM_PAYOS_API_KEY=your_payos_api_key
PLATFORM_PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Ticket / Seat Hold & Payment Expiration (15 minutes = 900s)
TICKET_HOLD_SECONDS=900

# Local AI (Ollama) — RTX 3070 8GB VRAM Profile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=eventhub-qwen3
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_VISION_FALLBACK_MODEL=moondream
OLLAMA_TIMEOUT_MS=360000
OLLAMA_VISION_TIMEOUT_MS=300000
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_THREAD=12
OLLAMA_NUM_BATCH=1024
OLLAMA_NUM_GPU=99

# Credential Encryption (AES-256-GCM HKDF)
CRED_MASTER_KEY_V1=your_hex_or_base64_master_key
CRED_MASTER_KEY_CURRENT=v1

# Financial AI Reporting
FINANCIAL_AI_MODEL=qwen3-eventhub-Q4_K_M.gguf
FINANCIAL_AI_TIMEOUT_MS=150000

# IoT Hardware Check-in (ESP32-S3)
IOT_PAIRING_TTL_MINUTES=15
IOT_PENDING_SECRET_TTL_MINUTES=10
IOT_HEARTBEAT_ONLINE_THRESHOLD_SEC=90
IOT_POLL_INTERVAL_SEC=4

