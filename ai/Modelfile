    {"policy_code": "<Mã điều khoản bắt buộc>", "issue": "<Mô tả chi tiết vi phạm bắt buộc>", "highlighted_text": "<Đoạn văn trích dẫn>"}
  ],
  "warnings": [
    {"policy_code": "<Mã điều khoản lưu ý>", "issue": "<Mô tả điểm cần hoàn thiện>", "highlighted_text": "<Đoạn văn trích dẫn>"}
  ],
  "suggestions": ["<Lời khuyên cải thiện có giá trị thực tế cho Nhà tổ chức>"]
}
